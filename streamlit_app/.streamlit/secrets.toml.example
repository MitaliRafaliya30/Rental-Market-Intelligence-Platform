# Example Snowflake credentials for Streamlit Cloud deployment.
# Copy this to .streamlit/secrets.toml and fill in your values.
# (DO NOT commit secrets.toml — it's gitignored.)
#
# For local development, leave secrets.toml empty or omitted.
# The app will fall back to your SNOWFLAKE_* environment variables
# (already configured for dbt).

[snowflake]
account = "xy12345.us-east-1"
user = "your_snowflake_username"
password = "your_snowflake_password"
role = "ANALYST"
warehouse = "COMPUTE_WH"
database = "RENTAL_MARKET_INTELLIGENCE"
schema = "GOLD"
