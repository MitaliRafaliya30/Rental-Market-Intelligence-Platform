# docker/.env  -  LOCAL Airflow infrastructure settings
# =====================================================
# Copy to docker/.env and fill in. docker/.env is gitignored.
#
# This file holds ONLY Airflow/Postgres infrastructure keys.
# Snowflake credentials are NOT here - they stay in the repo-root .env
# and are injected at runtime via `env_file: ../.env` in docker-compose.yml.
#
# Generate the three signing keys with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Postgres (Airflow metadata database) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=
POSTGRES_DB=airflow

# --- Airflow signing keys ---
# Must be identical across all Airflow components. In Airflow 3 the
# scheduler authenticates to the API server with a JWT; mismatched keys
# break task execution.
AIRFLOW_FERNET_KEY=
AIRFLOW_API_SECRET_KEY=
AIRFLOW_JWT_SECRET=

# --- Container user (Linux hosts; harmless on Docker Desktop) ---
AIRFLOW_UID=50000

# --- Gmail failure alerting (optional) ---
# Leave blank to disable email alerts entirely; the pipeline still runs.
# GMAIL_SMTP_APP_PASSWORD must be a Google APP PASSWORD (16 chars, generated at
# https://myaccount.google.com/apppasswords with 2FA enabled) - never your
# normal Gmail account password.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
